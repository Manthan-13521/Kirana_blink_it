{
  "name": "kirana-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply DB --config wrangler.local.jsonc --local && wrangler d1 migrations apply MEDIA --config wrangler.local.jsonc --local",
    "dev": "npm run build && npm run db:local && wrangler dev --config wrangler.local.jsonc --local --ip 127.0.0.1 --port 8787 --persist-to .wrangler/state",
    "test": "node --test tests/*.test.mjs",
    "test:plans": "node tests/query-plans.mjs",
    "benchmark": "node tests/workload.mjs",
    "release:prepare": "node tools/prepare-release.mjs",
    "deploy:staging": "node tools/deploy-staging.mjs",
    "setup:staging": "node tools/setup-staging.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "^1.9.23",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "hono": "^4.13.22",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  }
}
